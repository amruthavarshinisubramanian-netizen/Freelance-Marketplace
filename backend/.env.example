# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key for Session Tokens
JWT_SECRET=freelance_marketplace_super_secret_jwt_token_key_2026!
JWT_EXPIRES_IN=7d

# Database Connection Mode: "windows" (default on local Windows SQL Server) or "sql"
DB_AUTH_TYPE=windows

# Database Server & Name
DB_SERVER=localhost
DB_NAME=FreelanceMarketplaceDB

# SQL Server Authentication (only used if DB_AUTH_TYPE=sql)
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere
DB_PORT=1433

# Connection Options
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

