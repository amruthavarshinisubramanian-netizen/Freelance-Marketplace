# ============================================================================
# Freelance Marketplace Platform - Environment Configuration Example
# ============================================================================

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/FreelanceMarketplaceDB?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Backend Server Port
SERVER_PORT=8080

# JWT Security Key (At least 32 characters)
JWT_SECRET=freelance_marketplace_super_secret_jwt_token_key_2026_spring_boot_secure_32bytes!

